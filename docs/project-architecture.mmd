flowchart TB
    U["User / Scheduled Trading Session"] --> S["run_session.py<br/>Session controller"]
    S -->|starts or reuses| MCP["Local Alpaca MCP Server<br/>servers/alpaca_trading_mcpServer.py"]
    S -->|launches every 45 min by default| CREW["CrewAI workflow<br/>crew_ai/clients/trading_crew.py"]

    CREW <-->|"MCP tool calls"| MCP
    MCP <-->|"Paper account, market data, orders"| ALP["Alpaca Paper Trading API"]

    CREW --> INPUTS["Load watchlist, settings,<br/>account, positions and open orders"]
    INPUTS --> NEWS["News Sentiment Agent"]
    INPUTS --> TECH["Technical Analyst Agent"]
    NEWS --> NS["News sentiment scores"]
    TECH --> TS["Technical indicators and<br/>initial RAMS analysis"]
    NS --> RAMS["compute_rams()<br/>RAMS + market regime + signals"]
    TS --> RAMS

    RAMS --> PLAN["Python trading-plan logic<br/>allocation, quantities and safety rules"]
    PLAN --> RISK["Risk Manager Agent"]
    RISK --> TRADER["Trader Agent<br/>selects only proposed order numbers"]
    TRADER --> CHECK["Execution safeguards<br/>and dry-run / auto mode"]
    CHECK -->|when enabled| ORDERS["Validated limit orders<br/>via MCP"]
    ORDERS --> MCP

    CREW --> REPORTS["Per-agent Markdown reports<br/>settings_used.md / executionLog.md"]
    S --> SUMMARY["Daily summary and session log"]
    REPORTS --> OUT["crew_ai/outputs/<trader_name>/"]
    SUMMARY --> OUT
    OUT --> GIT["Git add, commit and push"]
    GIT --> GH["GitHub repository"]

    LLM["LLM provider(s)<br/>primary model + configured fallbacks"] <-->|"agent reasoning"| NEWS
    LLM <-->|"agent reasoning"| TECH
    LLM <-->|"agent reasoning"| RISK
    LLM <-->|"agent reasoning"| TRADER
