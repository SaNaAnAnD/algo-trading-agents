# Copy to .env (cp .env.example .env) and fill in. Never commit .env.
# Alpaca PAPER account keys (app.alpaca.markets > Paper > API Keys)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Free Groq key (console.groq.com > API Keys)
GROQ_API_KEY=
# Your first name, lower case: your records go to crew_ai/outputs/<name>/
TRADER_NAME=

# Trading switches (paper account)
TRADING_ENABLED=true
DRY_RUN=false
EXTENDED_HOURS=false
CREWAI_TRACING_ENABLED=false

# Careful allocation: 80% invested in healthy stocks at most, 20% cash
ALLOCATION=careful
TARGET_INVESTED=0.95
# Backtested rules: buy at RAMS 60+, sell below 30, no churn
HEALTHY_MIN_RAMS=60
MIN_HOLD_DAYS=3
CONFIRM_BUY_DAYS=1
CONFIRM_SELL_DAYS=2
COOLDOWN_DAYS=2
TAKE_HALF_PROFIT=false
MAX_POSITION_FRACTION=0.27
MAX_ORDER_VALUE_FRACTION=0.27
MAX_HIGH_BETA_POSITION_FRACTION=0.15
MAX_TRADE_RISK_FRACTION=0.017
PROTECTIVE_STOP_FRACTION=0.06
# Your high-beta stocks (comma list)
HIGH_BETA_SYMBOLS=

# Optional extra free AI fallbacks
OPENROUTER_API_KEY=
OLLAMA_URL=
OLLAMA_MODEL=
